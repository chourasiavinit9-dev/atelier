# Atelier Environment Variables
# Copy this file to .env.local and fill in real values

# Required: Gemini API key (obtain from https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Firestore project ID for plan caching (uses Application Default Credentials)
FIRESTORE_PROJECT_ID=your_gcp_project_id_here

# Optional: Google Cloud project (auto-detected on GCP/Cloud Run)
GCLOUD_PROJECT=your_gcp_project_id_here
